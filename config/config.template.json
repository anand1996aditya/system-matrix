{
  "_comment": "System Matrix Dashboard Configuration Template",
  "_instructions": "Copy this file to 'config.json' and fill in your values. The config.json file is git-ignored for security.",

  "system": {
    "_comment_install_path": "Auto-detected during setup - this placeholder will be replaced with actual install directory",
    "name": "System Matrix Dashboard",
    "version": "1.0.0",
    "install_path": "${HOME}/Claude-Code/System-Matrix",
    "user": "${USER}"
  },

  "paths": {
    "_comment_paths": "These paths are auto-detected during setup.sh and replaced with actual installation directory",
    "base_dir": "${HOME}/Claude-Code/System-Matrix",
    "dashboard_dir": "${HOME}/Claude-Code/System-Matrix/dashboard",
    "scripts_dir": "${HOME}/Claude-Code/System-Matrix/scripts",
    "logs_dir": "${HOME}/Claude-Code/System-Matrix/logs",
    "config_dir": "${HOME}/Claude-Code/System-Matrix/config",
    "cache_dir": "${HOME}/Claude-Code/System-Matrix/logs/cache",
    "alert_state_dir": "${HOME}/Claude-Code/System-Matrix/logs/alert-state",
    "metrics_state_dir": "${HOME}/Claude-Code/System-Matrix/logs/metrics-state",
    "backup_logs_dir": "${HOME}/.backup_logs"
  },

  "backup": {
    "_comment": "Backup paths will be configured during setup if drives are detected",
    "enabled": false,
    "scripts": {
      "google_drive": "",
      "custom_backup": ""
    },
    "paths": {
      "documents": "${HOME}/Documents"
    },
    "settings": {
      "min_disk_space_gb": 10,
      "max_wait_seconds": 300
    }
  },

  "drives": {
    "_comment": "External drives are auto-detected from /Volumes/. Add custom drives here if needed.",
    "auto_detect": true,
    "custom_drives": [
      {
        "_example": "Add your own drives here",
        "name": "My Custom Drive",
        "path": "/path/to/drive",
        "enabled": false
      }
    ],
    "exclude": ["Macintosh HD"]
  },

  "services": {
    "_comment": "Services (Docker, Tailscale, Plex, Pi-hole, etc.) are auto-detected. Only installed services will be shown.",
    "dashboard": {
      "port": 8888,
      "host": "0.0.0.0",
      "auth_required": true
    },
    "auto_detect": true,
    "show_only_installed": true
  },

  "notifications": {
    "telegram": {
      "enabled": true,
      "bot_token": "YOUR_BOT_TOKEN_HERE",
      "chat_id": "YOUR_CHAT_ID_HERE",
      "cooldown": {
        "critical": 600,
        "warning": 3600,
        "info": 7200
      }
    },
    "email": {
      "enabled": false,
      "smtp_server": "smtp.gmail.com",
      "smtp_port": 587,
      "from_address": "your-email@gmail.com",
      "to_address": "your-email@gmail.com",
      "password": "your-app-password"
    }
  },

  "alerts": {
    "memory_threshold_percent": 90,
    "disk_threshold_percent": 75,
    "cpu_temp_warning_celsius": 70,
    "cpu_temp_critical_celsius": 85,
    "backup_age_warning_hours": 24,
    "ssh_brute_force_threshold": 100,
    "bandwidth_spike_mbps": 50,
    "io_wait_threshold_percent": 20
  },

  "automation": {
    "unified_script": {
      "enabled": true,
      "schedule": "Daily at 3:00 AM",
      "tasks": {
        "_comment": "Tasks are auto-enabled based on installed services. Manual override available.",
        "backup": true,
        "docker_cleanup": "auto",
        "log_rotation": true,
        "pihole_update": "auto",
        "health_check": true,
        "performance_check": true,
        "external_drives_check": "auto"
      },
      "timeouts": {
        "docker_cleanup": 60,
        "log_rotation": 30,
        "pihole_update": 120,
        "health_check": 30,
        "performance_check": 30,
        "external_drives": 30
      }
    }
  },

  "monitoring": {
    "metrics_cache_ttl_seconds": 10,
    "pihole_cache_ttl_seconds": 5,
    "bandwidth_sample_interval_seconds": 1,
    "ping_timeout_ms": 200,
    "internet_check_hosts": ["8.8.8.8", "1.1.1.1"]
  },

  "dashboard_auth": {
    "username": "admin",
    "password_hash": "eb02a5d8adb2758f07af192a4ab68ddf4cdfeefd4cc72790b363c95c5b229af3",
    "_comment_password": "Default password is 'matrix2026' - change via setup.sh or change-dashboard-password.sh",
    "session_timeout_minutes": 60,
    "max_failed_attempts": 3,
    "lockout_duration_seconds": 180
  }
}
