{
  "_comment": "Minimal System Matrix Configuration - Bare essentials only",
  "_description": "This config provides basic monitoring with no alerts or automation. Perfect for testing or lightweight monitoring.",

  "system": {
    "name": "System Matrix Dashboard",
    "version": "1.0.0",
    "install_path": "${HOME}/system-matrix",
    "user": "${USER}"
  },

  "paths": {
    "base_dir": "${HOME}/system-matrix",
    "dashboard_dir": "${HOME}/system-matrix/dashboard",
    "scripts_dir": "${HOME}/system-matrix/scripts",
    "logs_dir": "${HOME}/system-matrix/logs",
    "config_dir": "${HOME}/system-matrix/config",
    "cache_dir": "${HOME}/system-matrix/logs/cache",
    "alert_state_dir": "${HOME}/system-matrix/logs/alert-state",
    "metrics_state_dir": "${HOME}/system-matrix/logs/metrics-state"
  },

  "services": {
    "dashboard": {
      "port": 8888,
      "host": "0.0.0.0",
      "auth_required": true
    },
    "auto_detect": true,
    "show_only_installed": true
  },

  "dashboard_auth": {
    "username": "admin",
    "password_hash": "eb02a5d8adb2758f07af192a4ab68ddf4cdfeefd4cc72790b363c95c5b229af3",
    "_comment_password": "Default password is 'matrix2026' - CHANGE THIS!",
    "session_timeout_minutes": 60,
    "max_failed_attempts": 3,
    "lockout_duration_seconds": 180
  },

  "monitoring": {
    "metrics_cache_ttl_seconds": 10,
    "pihole_cache_ttl_seconds": 5,
    "bandwidth_sample_interval_seconds": 1,
    "ping_timeout_ms": 200,
    "internet_check_hosts": ["8.8.8.8", "1.1.1.1"]
  },

  "notifications": {
    "telegram": {
      "enabled": false,
      "bot_token": "",
      "chat_id": ""
    }
  },

  "alerts": {
    "memory_threshold_percent": 95,
    "disk_threshold_percent": 90,
    "cpu_temp_warning_celsius": 80,
    "cpu_temp_critical_celsius": 95
  },

  "automation": {
    "unified_script": {
      "enabled": false
    }
  },

  "backup": {
    "enabled": false,
    "scripts": {
      "google_drive": "",
      "evm_drive": ""
    },
    "paths": {
      "documents": "${HOME}/Documents",
      "backup_logs_dir": "${HOME}/.backup_logs"
    },
    "settings": {
      "min_disk_space_gb": 10,
      "max_wait_seconds": 300
    }
  },

  "drives": {
    "auto_detect": true,
    "exclude": ["Macintosh HD"]
  }
}
