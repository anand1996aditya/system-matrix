<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.systemmatrix.automation</string>

    <key>ProgramArguments</key>
    <array>
        <string>INSTALL_PATH_HERE/scripts/automation/unified-automation.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Run daily at 3:00 AM -->
        <dict>
            <key>Hour</key>
            <integer>3</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>INSTALL_PATH_HERE/logs/unified-automation-launchagent.log</string>

    <key>StandardErrorPath</key>
    <string>INSTALL_PATH_HERE/logs/unified-automation-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>INSTALL_PATH_HERE</string>
</dict>
</plist>
